{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "auth",
  "main": "src/index.ts",
  "preview_urls": true,
  "workers_dev": true,
  "cache": {
    "enabled": true
  },
  "compatibility_date": "2026-07-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "placement": {
    "mode": "smart"
  },
  // `@react-email/render` imports Prettier at the top of its module to implement an option this
  // Worker never uses (`pretty: true`), which drags ~1.5 MB of formatter into the bundle and into
  // every cold start. The stub throws if anything actually calls it, so the day that assumption
  // stops holding is a loud failure rather than silently unformatted output.
  "alias": {
    "prettier/standalone": "../../packages/emails/src/prettier-stub.ts",
    "prettier/plugins/html": "../../packages/emails/src/prettier-stub.ts"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "franciscosolis_auth",
      "database_id": "426c094a-a532-4e05-8df0-ad850e34992a",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "hola@mail.franciscosolis.cl"
      ]
    }
  ],
  "vars": {
    // Public base URL this Worker is reachable at. It is NOT derived from the incoming
    // request because the Worker is only reachable through the `api` gateway's service
    // binding, where the request URL is an internal one. Magic links and the Google
    // redirect_uri are built from this value.
    "AUTH_PUBLIC_URL": "https://api.franciscosolis.cl/auth",
    // `iss` claim of every issued access token, and the issuer of the OIDC discovery doc.
    "AUTH_ISSUER": "https://api.franciscosolis.cl/auth",
    "MAIL_FROM_EMAIL": "hola@mail.franciscosolis.cl",
    "MAIL_FROM_NAME": "FranciscoSolis"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.25,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.25
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.25
    }
  }
}
