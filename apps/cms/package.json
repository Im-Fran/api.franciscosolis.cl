{
  "name": "cms",
  "type": "module",
  "license": "GPL-3.0-only",
  "version": "0.3.0",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port 8790 --inspector-port 9232",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply franciscosolis_cms --local",
    "db:migrate:remote": "wrangler d1 migrations apply franciscosolis_cms --remote"
  },
  "dependencies": {
    "@franciscosolis/emails": "workspace:*",
    "@hono/standard-validator": "catalog:",
    "@valibot/to-json-schema": "catalog:",
    "axios": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "hono-openapi": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
