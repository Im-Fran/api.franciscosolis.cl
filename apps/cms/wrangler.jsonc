{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cms",
  "main": "src/index.ts",
  "preview_urls": true,
  "workers_dev": true,
  "cache": {
    "enabled": true
  },
  "compatibility_date": "2026-07-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "placement": {
    "mode": "smart"
  },
  // `@react-email/render` imports Prettier at the top of its module to implement an option this
  // Worker never uses (`pretty: true`), which drags ~1.5 MB of formatter into the bundle and into
  // every cold start. The stub throws if anything actually calls it, so the day that assumption
  // stops holding is a loud failure rather than silently unformatted output.
  //
  // Unlike the bindings below, this is *not* restated under `env.dev`: `alias` is one of the keys a
  // named environment inherits, and Wrangler rejects it inside one ("Unexpected fields found in
  // env.dev field"). It was restated there at first, which cost nothing but a warning on every
  // deploy — the dev bundle came out byte for byte the size of the production one either way.
  "alias": {
    "prettier/standalone": "../../packages/emails/src/prettier-stub.ts",
    "prettier/plugins/html": "../../packages/emails/src/prettier-stub.ts"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "franciscosolis_cms",
      "database_id": "ca36fa0f-aa0d-4955-87b3-285a462a8e91",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      // Cloudflare rejects a send from any address not listed here, so this is the outer bound
      // of what the CMS can ever send as, regardless of what an editor puts in the request.
      "allowed_sender_addresses": [
        "hola@mail.franciscosolis.cl",
        "no-reply@mail.franciscosolis.cl"
      ]
    }
  ],
  // Workers AI, and the only thing this Worker asks it for: a first-draft translation of one prose
  // field, offered in the editor's translation modal and saved like any other override. It is never
  // on the path that saves a record — see `src/routes/admin/translate.ts`.
  //
  // Workers AI has no local simulation, so it always runs against the real service. That is also
  // why the `test` environment below leaves this binding out: the Vitest pool answers an `ai`
  // binding by opening a remote proxy session against the real account.
  "ai": {
    "binding": "AI"
  },
  "services": [
    {
      // Only ever asked for `/.well-known/jwks.json`. It is a binding rather than a public fetch
      // because a Worker's subrequest to its own zone skips the Workers routing layer and is sent
      // to the zone's origin — and `api.franciscosolis.cl` has none, so every attempt came back
      // 522 and the gate below refused every token it was ever handed.
      "binding": "AUTH",
      "service": "auth"
    }
  ],
  "vars": {
    // Path the JWKS is read from, over the AUTH service binding above. The host is a placeholder:
    // a service binding routes by binding, not by DNS. Tokens are still verified offline — this
    // fetches public keys, it does not ask auth to validate anything.
    "AUTH_JWKS_URL": "https://auth.internal/.well-known/jwks.json",
    // Expected `iss` claim. Must match `AUTH_ISSUER` in apps/auth/wrangler.jsonc exactly.
    "AUTH_ISSUER": "https://api.franciscosolis.cl/auth",
    // Comma-separated client application ids (the `aud` claim) whose tokens may reach the CMS.
    // A token minted for the public website is not accepted here.
    "CMS_ALLOWED_AUDIENCES": "franciscosolis-cms",
    // Comma-separated email domains allowed into the CMS. This is the access gate: an account
    // outside these domains is refused even with a perfectly valid access token.
    "CMS_ALLOWED_EMAIL_DOMAINS": "franciscosolis.cl",
    // Default sender for outgoing mail. Must be one of `allowed_sender_addresses` above.
    "MAIL_FROM_EMAIL": "hola@mail.franciscosolis.cl",
    "MAIL_FROM_NAME": "Francisco Solis",
    // Senders an editor may pick per message. Subset of `allowed_sender_addresses`.
    "MAIL_ALLOWED_SENDERS": "hola@mail.franciscosolis.cl,no-reply@mail.franciscosolis.cl",
    // Workers AI model behind the translation drafts. A var rather than a constant so a model that
    // Cloudflare retires — on their schedule, not ours — is a deploy rather than a code change.
    "AI_TEXT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.25,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.25
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.25
    }
  },
  // The development stack: `cms-dev`, behind api-dev.franciscosolis.cl/cms.
  //
  // Restated in full because a named environment inherits no bindings. Two things carry the safety
  // here: the database is the `-dev` copy, so editing content on dev cannot publish to the real
  // site, and `AUTH_ISSUER` names the dev issuer, so a production token is refused here and a dev
  // token is refused in production.
  "env": {
    "dev": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "franciscosolis_cms_dev",
          "database_id": "57d1c8c6-2105-43df-a6bd-dccab8e200d4",
          "migrations_dir": "migrations"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": [
            "hola@mail.franciscosolis.cl",
            "no-reply@mail.franciscosolis.cl"
          ]
        }
      ],
      "ai": {
        "binding": "AI"
      },
      "services": [
        {
          "binding": "AUTH",
          "service": "auth-dev"
        }
      ],
      "vars": {
        "AUTH_JWKS_URL": "https://auth.internal/.well-known/jwks.json",
        "AUTH_ISSUER": "https://api-dev.franciscosolis.cl/auth",
        "CMS_ALLOWED_AUDIENCES": "franciscosolis-cms",
        "CMS_ALLOWED_EMAIL_DOMAINS": "franciscosolis.cl",
        "MAIL_FROM_EMAIL": "hola@mail.franciscosolis.cl",
        "MAIL_FROM_NAME": "Francisco Solis (dev)",
        "MAIL_ALLOWED_SENDERS": "hola@mail.franciscosolis.cl,no-reply@mail.franciscosolis.cl",
        "AI_TEXT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
      }
    },
    // The environment the test suite runs against, and the only reason it exists is the `ai`
    // binding above. Workers AI has no local emulation, so @cloudflare/vitest-pool-workers responds
    // to that binding by opening a *remote proxy session* against the real account — which needs a
    // CLOUDFLARE_API_TOKEN, which CI deliberately does not have, and which would bill real neurons
    // for a unit test either way. A named environment inherits nothing, so everything the suite
    // needs is restated here and the binding that must not be reached is simply absent.
    //
    // The suite supplies its own `env.AI` by assignment instead — see `test/helpers/ai.ts`. That has
    // the useful property that any code path reaching the real service in a test throws loudly.
    "test": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "franciscosolis_cms",
          "database_id": "ca36fa0f-aa0d-4955-87b3-285a462a8e91",
          "migrations_dir": "migrations"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": [
            "hola@mail.franciscosolis.cl",
            "no-reply@mail.franciscosolis.cl"
          ]
        }
      ],
      "services": [
        {
          "binding": "AUTH",
          "service": "auth"
        }
      ],
      "vars": {
        "AUTH_JWKS_URL": "https://auth.test/.well-known/jwks.json",
        "AUTH_ISSUER": "https://auth.test",
        "CMS_ALLOWED_AUDIENCES": "franciscosolis-cms",
        "CMS_ALLOWED_EMAIL_DOMAINS": "franciscosolis.cl",
        "MAIL_FROM_EMAIL": "hola@mail.franciscosolis.cl",
        "MAIL_FROM_NAME": "Francisco Solis",
        "MAIL_ALLOWED_SENDERS": "hola@mail.franciscosolis.cl,no-reply@mail.franciscosolis.cl",
        "AI_TEXT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
      }
    }
  }
}
