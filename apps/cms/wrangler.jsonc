{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cms",
  "main": "src/index.ts",
  "preview_urls": true,
  "workers_dev": true,
  "cache": {
    "enabled": true
  },
  "compatibility_date": "2026-07-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "placement": {
    "mode": "smart"
  },
  // `@react-email/render` imports Prettier at the top of its module to implement an option this
  // Worker never uses (`pretty: true`), which drags ~1.5 MB of formatter into the bundle and into
  // every cold start. The stub throws if anything actually calls it, so the day that assumption
  // stops holding is a loud failure rather than silently unformatted output.
  "alias": {
    "prettier/standalone": "../../packages/emails/src/prettier-stub.ts",
    "prettier/plugins/html": "../../packages/emails/src/prettier-stub.ts"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "franciscosolis_cms",
      "database_id": "ca36fa0f-aa0d-4955-87b3-285a462a8e91",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      // Cloudflare rejects a send from any address not listed here, so this is the outer bound
      // of what the CMS can ever send as, regardless of what an editor puts in the request.
      "allowed_sender_addresses": [
        "hola@mail.franciscosolis.cl",
        "no-reply@mail.franciscosolis.cl"
      ]
    }
  ],
  "services": [
    {
      // Only ever asked for `/.well-known/jwks.json`. It is a binding rather than a public fetch
      // because a Worker's subrequest to its own zone skips the Workers routing layer and is sent
      // to the zone's origin — and `api.franciscosolis.cl` has none, so every attempt came back
      // 522 and the gate below refused every token it was ever handed.
      "binding": "AUTH",
      "service": "auth"
    }
  ],
  "vars": {
    // Path the JWKS is read from, over the AUTH service binding above. The host is a placeholder:
    // a service binding routes by binding, not by DNS. Tokens are still verified offline — this
    // fetches public keys, it does not ask auth to validate anything.
    "AUTH_JWKS_URL": "https://auth.internal/.well-known/jwks.json",
    // Expected `iss` claim. Must match `AUTH_ISSUER` in apps/auth/wrangler.jsonc exactly.
    "AUTH_ISSUER": "https://api.franciscosolis.cl/auth",
    // Comma-separated client application ids (the `aud` claim) whose tokens may reach the CMS.
    // A token minted for the public website is not accepted here.
    "CMS_ALLOWED_AUDIENCES": "franciscosolis-cms",
    // Comma-separated email domains allowed into the CMS. This is the access gate: an account
    // outside these domains is refused even with a perfectly valid access token.
    "CMS_ALLOWED_EMAIL_DOMAINS": "franciscosolis.cl",
    // Default sender for outgoing mail. Must be one of `allowed_sender_addresses` above.
    "MAIL_FROM_EMAIL": "hola@mail.franciscosolis.cl",
    "MAIL_FROM_NAME": "Francisco Solis",
    // Senders an editor may pick per message. Subset of `allowed_sender_addresses`.
    "MAIL_ALLOWED_SENDERS": "hola@mail.franciscosolis.cl,no-reply@mail.franciscosolis.cl"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.25,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.25
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.25
    }
  }
}
