# The CMS has no secrets of its own: it verifies access tokens against the public JWKS of the
# auth Worker, so there is no signing key or client secret to keep here.
#
# This file only overrides the vars declared in wrangler.jsonc so a local CMS trusts the local
# auth Worker (through the local gateway) instead of production.
AUTH_JWKS_URL=http://localhost:8787/auth/.well-known/jwks.json
AUTH_ISSUER=http://localhost:8787/auth
