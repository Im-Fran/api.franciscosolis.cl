{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pages",
  "main": "src/index.ts",
  "preview_urls": true,
  "workers_dev": true,
  "cache": {
    "enabled": true
  },
  "compatibility_date": "2026-07-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "placement": {
    "mode": "smart"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "franciscosolis_pages",
      "database_id": "9fe9b5de-c4aa-42e9-88a5-72347ca41712",
      "migrations_dir": "migrations"
    }
  ],
  "services": [
    {
      // Only ever asked for `/.well-known/jwks.json`, and a binding rather than a public fetch for
      // the reason spelled out in `src/lib/jwks.ts`: a Worker's subrequest to its own zone skips
      // Workers routing and is sent to the zone's origin, which `api.franciscosolis.cl` has none of.
      "binding": "AUTH",
      "service": "auth"
    }
  ],
  "vars": {
    // Path the JWKS is read from, over the AUTH service binding above. The host is a placeholder:
    // a service binding routes by binding, not by DNS. Tokens are still verified offline — this
    // fetches public keys, it does not ask auth to validate anything.
    "AUTH_JWKS_URL": "https://auth.internal/.well-known/jwks.json",
    // Expected `iss` claim. Must match `AUTH_ISSUER` in apps/auth/wrangler.jsonc exactly.
    "AUTH_ISSUER": "https://api.franciscosolis.cl/auth",
    // Comma-separated client application ids (the `aud` claim) whose tokens may write here. The
    // editorial front-end for this Worker is a section of the CMS interface at
    // `franciscosolis.cl/cms/pages`, which signs in under the CMS's own client id — so that is the
    // audience accepted, and there is no second application to register.
    "PAGES_ALLOWED_AUDIENCES": "franciscosolis-cms",
    // Comma-separated email domains allowed to edit. This is the access gate: an account outside
    // these domains is refused even with a perfectly valid access token.
    "PAGES_ALLOWED_EMAIL_DOMAINS": "franciscosolis.cl"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.25,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.25
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.25
    }
  }
}
