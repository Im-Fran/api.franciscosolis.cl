{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pages",
  "main": "src/index.ts",
  "preview_urls": true,
  "workers_dev": true,
  "cache": {
    "enabled": true
  },
  "compatibility_date": "2026-07-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "placement": {
    "mode": "smart"
  },
  // `@react-email/render` imports Prettier at the top of its module to implement an option this
  // Worker never uses (`pretty: true`), which drags ~1.5 MB of formatter into the bundle and into
  // every cold start. The stub throws if anything actually calls it, so the day that assumption
  // stops holding is a loud failure rather than silently unformatted output.
  //
  // Unlike the bindings below, this is deliberately *not* restated under `env.dev`: `alias` is one
  // of the keys a named environment inherits, and Wrangler rejects it inside one. `apps/cms` has the
  // same block for the same reason, and `scripts/check-environments.mjs` fails a copy of it in an
  // environment.
  "alias": {
    "prettier/standalone": "../../packages/emails/src/prettier-stub.ts",
    "prettier/plugins/html": "../../packages/emails/src/prettier-stub.ts"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "franciscosolis_pages",
      "database_id": "9fe9b5de-c4aa-42e9-88a5-72347ca41712",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      // The downloadable builds. No public access of its own and no custom domain: every byte is
      // served by `GET /downloads/:ticket`, which is the only place the payment state of an
      // application can be consulted. A public bucket cannot be asked whether somebody paid.
      "binding": "RELEASES",
      "bucket_name": "franciscosolis-app-releases"
    }
  ],
  "send_email": [
    {
      // The voucher, and the notice that one was refunded. Nothing else: this Worker sends receipts
      // and does not correspond — a reply belongs on a support ticket, not in a payments service.
      //
      // Cloudflare rejects a send from any address not listed here, so this is the outer bound of
      // what this Worker can ever send as. There is only one, because unlike the CMS nothing here
      // lets a request choose a sender.
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "no-reply@mail.franciscosolis.cl"
      ]
    }
  ],
  "services": [
    {
      // Only ever asked for `/.well-known/jwks.json`, and a binding rather than a public fetch for
      // the reason spelled out in `src/lib/jwks.ts`: a Worker's subrequest to its own zone skips
      // Workers routing and is sent to the zone's origin, which `api.franciscosolis.cl` has none of.
      "binding": "AUTH",
      "service": "auth"
    }
  ],
  "vars": {
    // Path the JWKS is read from, over the AUTH service binding above. The host is a placeholder:
    // a service binding routes by binding, not by DNS. Tokens are still verified offline — this
    // fetches public keys, it does not ask auth to validate anything.
    "AUTH_JWKS_URL": "https://auth.internal/.well-known/jwks.json",
    // Expected `iss` claim. Must match `AUTH_ISSUER` in apps/auth/wrangler.jsonc exactly.
    "AUTH_ISSUER": "https://api.franciscosolis.cl/auth",
    // Comma-separated client application ids (the `aud` claim) whose tokens may write here. The
    // editorial front-end for this Worker is a section of the CMS interface at
    // `franciscosolis.cl/cms/pages`, which signs in under the CMS's own client id — so that is the
    // audience accepted, and there is no second application to register.
    "PAGES_ALLOWED_AUDIENCES": "franciscosolis-cms",
    // Comma-separated email domains allowed to edit. This is the access gate: an account outside
    // these domains is refused even with a perfectly valid access token.
    "PAGES_ALLOWED_EMAIL_DOMAINS": "franciscosolis.cl",
    // Client ids whose tokens identify a *buyer* rather than an editor: the public website. A second
    // list rather than an addition to the one above, so widening the website's reach can never widen
    // `/admin`'s — the same split `apps/support` keeps between its console and its requesters.
    "PAGES_ACCOUNT_AUDIENCES": "franciscosolis-web",
    // Public base URL of this Worker through the gateway. Used to build the download links handed to a
    // browser and the notification URL MercadoPago posts to; neither is derivable from the request,
    // because behind a service binding the incoming URL is an internal one.
    "PAGES_PUBLIC_URL": "https://api.franciscosolis.cl/pages",
    // Website the buyer is returned to after checkout. `back_urls` point at pages here, never at the
    // API: a person coming back from MercadoPago should land on the application page.
    "SITE_BASE_URL": "https://franciscosolis.cl",
    // Address every voucher and refund notice goes out as, and the name the email footer signs off
    // with. `no-reply`, deliberately: a receipt is not a conversation, and an answer to one belongs
    // on a support ticket where somebody will see it.
    "MAIL_FROM_EMAIL": "no-reply@mail.franciscosolis.cl",
    "MAIL_FROM_NAME": "FranciscoSolis",
    // Which MercadoPago account this Worker takes money against, and therefore which of the two
    // checkout URLs a created preference is answered with. `live` here and `sandbox` under env.dev;
    // it is also stamped onto every purchase, so a test payment can never be counted as revenue and
    // a refund is never attempted against the account that never saw the payment.
    "MERCADOPAGO_ENVIRONMENT": "live"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.25,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.25
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.25
    }
  },
  // The development stack: `pages-dev`, behind api-dev.franciscosolis.cl/pages.
  //
  // This is the Worker where an isolated environment earns its keep, because this is the one that
  // takes money. Four things are deliberate:
  //
  // - The bucket is `franciscosolis-app-releases-dev`. A download route reads the payment state of
  //   an application before it hands back a byte, and a dev database paired with the production
  //   bucket would be a payment table that knows nothing about the builds it is gating.
  // - `MERCADOPAGO_ACCESS_TOKEN` and `MERCADOPAGO_WEBHOOK_SECRET` are secrets, so they are set per
  //   environment. Give dev a *test* credential; a production one here would take real money for a
  //   test.
  // - `MERCADOPAGO_ENVIRONMENT` is `sandbox`, and it is what actually sends the browser to the
  //   sandbox checkout. A test credential answers a preference with *both* URLs and they are two
  //   different checkouts, so "it has a test token, therefore it is a test payment" was never true
  //   on its own — the variable is the half that decides, and it is stamped on every purchase.
  // - `DOWNLOAD_SIGNING_KEY` is likewise per environment, which is what keeps a ticket minted on
  //   dev from opening a download in production.
  "env": {
    "dev": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "franciscosolis_pages_dev",
          "database_id": "375b7df8-0573-4847-9425-6f6110444550",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "RELEASES",
          "bucket_name": "franciscosolis-app-releases-dev"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": [
            "no-reply@mail.franciscosolis.cl"
          ]
        }
      ],
      "services": [
        {
          "binding": "AUTH",
          "service": "auth-dev"
        }
      ],
      "vars": {
        "AUTH_JWKS_URL": "https://auth.internal/.well-known/jwks.json",
        "AUTH_ISSUER": "https://api-dev.franciscosolis.cl/auth",
        "PAGES_ALLOWED_AUDIENCES": "franciscosolis-cms",
        "PAGES_ALLOWED_EMAIL_DOMAINS": "franciscosolis.cl",
        "PAGES_ACCOUNT_AUDIENCES": "franciscosolis-web",
        // Both of these are what MercadoPago is told to come back to, so both have to name the
        // development stack: the notification URL is built from the first, and a buyer returning
        // from checkout lands on the second.
        "PAGES_PUBLIC_URL": "https://api-dev.franciscosolis.cl/pages",
        "SITE_BASE_URL": "https://dev.franciscosolis.cl",
        // The same sender: Email Sending verifies a domain rather than a stack, and a `no-reply`
        // address has no inbox on either side to keep apart.
        "MAIL_FROM_EMAIL": "no-reply@mail.franciscosolis.cl",
        "MAIL_FROM_NAME": "FranciscoSolis (dev)",
        // The whole reason this Worker has a development stack at all. With `sandbox` here the
        // browser is sent to the preference's `sandbox_init_point`, which is the checkout the
        // provider's test cards work on — and every purchase taken here is stamped `sandbox`, so it
        // is structurally impossible for one to be read as revenue or refunded against the live
        // account. Pair it with a *test* credential in `wrangler secret put --env dev`.
        "MERCADOPAGO_ENVIRONMENT": "sandbox"
      }
    }
  }
}
