{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "landing",
  "main": "src/index.ts",
  "preview_urls": true,
  "workers_dev": true,
  "cache": {
    "enabled": true
  },
  "compatibility_date": "2026-07-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.25,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.25
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.25
    }
  }
}