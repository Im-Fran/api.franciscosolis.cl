{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "landing",
  "main": "src/index.ts",
  "preview_urls": true,
  "workers_dev": true,
  "cache": {
    "enabled": true
  },
  "compatibility_date": "2026-07-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.25,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.25
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.25
    }
  },
  // The development stack: `landing-dev`, reached only through the `api-dev` gateway's service binding.
  //
  // The block is empty because this Worker holds no bindings of its own: everything it needs is an
  // inheritable top-level key, and its one secret (`GH_TOKEN`) is set per environment with
  // `wrangler secret put --env dev`. It still has to exist — `wrangler deploy --env dev` fails on
  // an environment that is not declared, which is the failure mode worth having.
  "env": {
    "dev": {}
  }
}
