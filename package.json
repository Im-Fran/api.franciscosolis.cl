{
  "name": "franciscosolis-api",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@11.17.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Im-Fran/api.franciscosolis.cl.git"
  },
  "scripts": {
    "dev": "pnpm run -r --parallel --aggregate-output dev",
    "build": "pnpm run -r build",
    "deploy": "pnpm run -r deploy",
    "db:migrate:local": "pnpm run -r db:migrate:local",
    "db:migrate:remote": "pnpm run -r db:migrate:remote",
    "db:migrate:list": "pnpm run -r db:migrate:list",
    "cf-typegen": "pnpm run -r cf-typegen",
    "typecheck": "pnpm run -r typecheck",
    "test": "pnpm run -r test",
    "test:coverage": "pnpm run -r test:coverage"
  }
}
